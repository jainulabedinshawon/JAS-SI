{
  "name": "jas-si/php-sdk",
  "description": "PHP client for the JAS-SI REST API",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "JASSI\\\\": "sdks/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JASSI\\\\Tests\\\\": "sdks/php/tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration sdks/php/phpunit.xml",
    "analyse": "phpstan analyse --configuration=sdks/php/phpstan.neon --no-progress"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
